# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 gitignore 되어 커밋되지 않는다.
# 셸에서 export 한 환경변수가 .env 보다 우선한다. 모든 값은 비워 둬도 앱은 실행된다.

# --- LLM (답변 생성, 한국어 질문 -> 영어 검색어 변환) ---
# LLM_PROVIDER=openai          # openai(기본) | anthropic. 고른 쪽 키만 있으면 된다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_MODEL=                   # 기본: openai=gpt-5-mini, anthropic=claude-opus-5-5
# LLM_EFFORT=medium            # low | medium | high | xhigh | max (모델이 지원하는 값만)
# REWRITE_MODEL=               # 기본: LLM_MODEL 과 같음

# --- Microsoft-Decision-1 (Microsoft Foundry 배포) ---
DECISION_ENDPOINT=             # 예: https://<resource>.services.ai.azure.com
DECISION_DEPLOYMENT=           # Foundry 에서 만든 배포 이름
DECISION_API_KEY=

# --- 검색/라우팅 ---
# SEARCH_TOP_K=8               # Decision-1 에 넘길 후보 페이지 수
# MIN_CONFIDENCE=0.5           # 이보다 낮으면 상담원 연결
# SECOND_PAGE_MIN=0.2          # 2순위 확률이 이 이상이면 근거 페이지로 같이 전달
# DIRECT_ANSWER_THRESHOLD=     # 설정 시 이 확률 이상이면 LLM 없이 위키 대표 답변 발송
