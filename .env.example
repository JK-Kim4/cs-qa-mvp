# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 gitignore 되어 커밋되지 않는다.
# 셸에서 export 한 환경변수가 .env 보다 우선한다. 모든 값은 비워 둬도 앱은 실행된다.

# --- LLM (답변 생성, 한국어 질문 -> 영어 검색어 변환) ---
# LLM_PROVIDER=openai          # openai(기본) | anthropic. 고른 쪽 키만 있으면 된다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_MODEL=                   # 기본: openai=gpt-5-mini, anthropic=claude-opus-5-5
# LLM_EFFORT=medium            # low | medium | high | xhigh | max (모델이 지원하는 값만)
# REWRITE_MODEL=               # 기본: LLM_MODEL 과 같음

# --- 판단 모델 (System One): 검색 후보 중 하나(또는 '해당 없음')를 확률로 고른다 ---
# 구현체: typesafe | openrouter | azure. 비우면 키가 설정된 첫 구현체를 이 순서로 자동 선택한다.
# DECISION_PROVIDER=
# (1) TypeSafe Jev 직접 호출 (https://console.typesafe.ai)
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# (2) TypeSafe Jev via OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# OPENROUTER_DECISION_MODEL=typesafe/jev-1.13
# (3) Microsoft-Decision-1 (Microsoft Foundry 배포, 할당량 승인 필요)
DECISION_ENDPOINT=             # 예: https://<resource>.services.ai.azure.com
DECISION_DEPLOYMENT=           # Foundry 에서 만든 배포 이름
DECISION_API_KEY=

# --- 검색/라우팅 ---
# SEARCH_TOP_K=8               # 판단 모델에 넘길 후보 페이지 수
# MIN_CONFIDENCE=0.5           # 이보다 낮으면 상담원 연결
# SECOND_PAGE_MIN=0.2          # 2순위 확률이 이 이상이면 근거 페이지로 같이 전달
# DIRECT_ANSWER_THRESHOLD=     # 설정 시 이 확률 이상이면 LLM 없이 위키 대표 답변 발송

# --- 노션 티켓: 채팅 화면에서 '상담 종료'를 누르면 대화를 요약·분류해 노션 CS 처리 보드에 카드를 만든다 ---
# 둘 다 있어야 켜진다. 토큰의 통합(연결)이 보드가 있는 노션 페이지에 연결돼 있어야 한다 (아니면 404).
NOTION_TOKEN=
# CS 처리 보드의 데이터 소스 ID
NOTION_DATA_SOURCE_ID=
